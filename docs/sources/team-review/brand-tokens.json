      }
    },
    "uzbekApostrophe": {
      "rule": "Store and render U+02BB (ʻ, MODIFIER LETTER TURNED COMMA) in oʻ, gʻ and in the tutuq belgisi of loanwords (maʼlumot uses U+02BC ʼ).",
      "normalise": "On input and in copy pipelines: after o/O/g/G, map U+0027 ', U+2018 ‘, U+2019 ’, U+02BC ʼ, U+0060 ` → U+02BB. Elsewhere map U+0027/U+2019 between letters → U+02BC.",
      "search": "Match all variants as equal (fold to U+02BB before comparing).",
      "regex": "/([oOgG])['\\u2018\\u2019\\u02BC`]/g → '$1\\u02BB'",
      "doNotUse": "IBM Plex Sans (its U+02BB is 0.60 em wide)."
    }
