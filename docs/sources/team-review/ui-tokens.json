    "flags": [
      {
        "id": "saffron-on-light",
        "severity": "P0-usage",
        "colors": [
          "#F5B43C",
          "#FFFFFF",
          "#F5F5FA"
        ],
        "ratio": 1.83,
        "issue": "Saffron fails WCAG AA (and AAA) for text on white/canvas (1.83:1 / 1.68:1). It also fails WCAG 1.4.11 non-text contrast (3:1) as a standalone icon or graphic on a light background. White text on saffron also fails (1.83:1).",
        "okUse": "Saffron on ink #14152B is 9.79:1 (AAA). Saffron on indigo #2E2BA0 is 5.83:1 (AA) — this is how the Varaq fold sits on the mark. Ink text on a saffron fill would pass, but brand reserves saffron and forbids saffron buttons."
      },
      {
        "id": "muted-on-sunken-or-tint",
        "severity": "P1-usage",
        "colors": [
          "#5E6178",
          "#EEEFF5",
          "#ECEBFA"
        ],
        "ratio": 4.35,
        "issue": "Muted text is 4.35:1 on sunken and 4.24:1 on brand tint — both below 4.5:1 AA for normal (13–16 px) text. It does pass on surface (4.99) and canvas (4.60).",
        "okUse": "On sunken or tint backgrounds use secondary #525570 (6.33 / 6.17) or ink."
      },
      {
        "id": "input-border-too-faint",
        "severity": "P1-token-gap",
        "colors": [
          "#E1E2EC",
          "#C5CCD8",
          "#FFFFFF"
        ],
        "ratio": 1.62,
        "issue": "Neither border.line (1.29:1) nor border.strong (1.62:1) meets the 3:1 non-text contrast needed for an input outline that is the only visible edge of a field.",
        "okUse": "Focus ring #2E2BA0 on white is 10.66:1 (AAA). For the resting input, UI recommends #84899A until Brand Designer confirms a stronger border token."
      }
