# Copy to .env. Do not put real secrets in this file or in git.
# All persistent data stays in Uzbekistan. See docs/cicd.md.

# --- runtime ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
CONSOLE_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:4000
MOCK_CABINET_URL=http://localhost:4010
DESKTOP_PROTOCOL=yuklago

# --- data plane (Uzbekistan in staging and production) ---
DATABASE_URL=postgresql://yuklago:yuklago@localhost:5432/yuklago
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=yuklago-documents
S3_REGION=uz-local
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local-dev-only

# --- auth ---
# HMAC key for PINFL / STIR / certificate serial. Generate locally. Never log it.
SIGNER_HMAC_KEY=replace-with-a-long-random-string
SESSION_TTL_HOURS=12
DESKTOP_IDLE_MINUTES=15
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_LOCK_MINUTES=10
# Dev only. Ignored when NODE_ENV=production.
DEV_OTP_CODE=000000

# --- SMS ---
# Provider is not chosen (spec Q-4). The dev sender prints the code to the API log.
SMS_PROVIDER=dev-log
SMS_SENDER_ID=YuklaGo

# --- product flags (defaults match spec §3A.1) ---
ED2_LIVE_AUTOMATION=false
CABINET_STATUS_READ=false
XML_EXPORT=false
DESKTOP_ENGINE=electron
DESKTOP_EIMZO_COMPAT=unverified
DESKTOP_EIMZO_SIGNING=unverified
AUTOMATION_SAVE_DRAFT_CLICK=false
CERT_PUBLIC_FIELDS_AUTODETECT=true
SUPPORT_ACCESS_DEFAULT_HOURS=24
AUDIT_LOG_RETENTION_YEARS=3
AI_ADAPTER=stub
# Live adapter is founder-owned. Leave empty while AI_ADAPTER=stub.
AI_LIVE_REGION=
AI_LIVE_PROJECT=

# --- allowed embedded-browser origins ---
# Live ed2, ed1 and cargo are loaded only when ED2_LIVE_AUTOMATION=true.
CABINET_ALLOWLIST=http://localhost:4010,https://mashq.yuklago.uz

# --- observability (no personal data, no model request text) ---
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
